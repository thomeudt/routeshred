# ============================================================
# routeshred – Umgebungsvariablen (Vorlage)
# Kopiere als .env und setze eigene Werte.
# .env wird NICHT in Git eingecheckt.
# ============================================================

# Keycloak Admin-Zugangsdaten
KEYCLOAK_ADMIN=routeshred-admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Keycloak-Datenbank (Postgres)
KC_DB_USER=kc_routeshred
KC_DB_PASSWORD=change-me

# Keycloak App-Konfiguration
KEYCLOAK_ENABLED=true
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=routeshred
KEYCLOAK_CLIENT_ID=routeshred-frontend

# Frontend (CRA build-time)
REACT_APP_KEYCLOAK_ENABLED=true
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_KEYCLOAK_REALM=routeshred
REACT_APP_KEYCLOAK_CLIENT_ID=routeshred-frontend

# ------------------------------------------------------------
# One-stack Deployment (Proxmox / Docker Compose)
# ------------------------------------------------------------
# Public hostname used by reverse proxy + Keycloak
PUBLIC_HOSTNAME=route.example.com

# Full public base URL used for frontend build-time auth URL
PUBLIC_BASE_URL=https://route.example.com

# Optional: override routing/tile endpoints in deployment stack
# OSRM_API=http://router.project-osrm.org
# ROUTING_ENGINE=brouter
# REACT_APP_TILE_URL=https://tile.thunderforest.com/cycle/{z}/{x}/{y}.png?apikey=YOUR_KEY
# REACT_APP_TILE_ATTRIBUTION=&copy; OpenCycleMap

# Optional: POI search provider for location lookup
# overpass (default) | geoapify
# POI_PROVIDER=geoapify

# Optional: Overpass endpoint override(s) used by routing/cycleway lookup.
# OVERPASS_API=https://overpass-api.de/api/interpreter
# OVERPASS_API_LIST=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://lz4.overpass-api.de/api/interpreter

# Optional: Geoapify API key (required when POI_PROVIDER=geoapify)
# GEOAPIFY_API_KEY=your_geoapify_key
