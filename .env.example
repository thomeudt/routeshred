# ============================================================
# RouteShred – Umgebungsvariablen (Vorlage)
# Kopiere diese Datei als .env und setze eigene Werte.
# .env wird NICHT in Git eingecheckt.
# ============================================================


# ------------------------------------------------------------
# Server
# ------------------------------------------------------------

# HTTP-Port des Backends
# PORT=5050

# Maximale Request-Body-Größe (für GPX-Import o.ä.)
# BODY_LIMIT=10mb

# Erlaubte CORS-Origins (kommagetrennt). Im Proxmox-Stack automatisch auf PUBLIC_BASE_URL gesetzt.
# CORS_ORIGIN=https://route.example.com


# ------------------------------------------------------------
# One-Stack Deployment (Proxmox / Docker Compose)
# ------------------------------------------------------------

# Öffentlicher Hostname – wird vom Reverse Proxy und Keycloak verwendet
PUBLIC_HOSTNAME=route.example.com

# Vollständige öffentliche Base-URL – wird in den React-Build eingebaut
PUBLIC_BASE_URL=https://route.example.com

# Steht der Stack selbst hinter einem weiteren Reverse Proxy (z.B. Nginx Proxy Manager),
# muss Keycloak x-forwarded-headers respektieren.
# Siehe docker-compose.proxmox.yml: KC_PROXY_HEADERS=xforwarded


# ------------------------------------------------------------
# Routing-Engine
# ------------------------------------------------------------

# Primäre Routing-Engine: brouter (Standard) oder osrm
ROUTING_ENGINE=brouter

# BRouter-Endpunkt (Docker-intern: http://brouter:17777/brouter)
# BROUTER_API=http://localhost:17777/brouter

# Automatisch fehlende .rd5-Segment-Tiles nachladen
# BROUTER_AUTO_FETCH_SEGMENTS=true

# Lokales Verzeichnis für BRouter-Segment-Tiles
# BROUTER_SEGMENTS_DIR=../brouter-data/segments4

# Download-Quelle für .rd5-Tiles
# BROUTER_SEGMENTS_BASE_URL=https://brouter.de/brouter/segments4

# Verzeichnis für eigene .brf-Profile (benutzerdefinierte Routing-Profile)
# BROUTER_CUSTOM_PROFILES_DIR=../brouter-data/customprofiles

# Bei BRouter-Ausfall automatisch auf OSRM zurückfallen
BROUTER_FALLBACK_TO_OSRM=false

# OSRM-Endpunkt (Fallback oder ROUTING_ENGINE=osrm)
# OSRM_API=http://router.project-osrm.org


# ------------------------------------------------------------
# Optionale Routen-Anreicherung (Overpass-Lookups)
# ------------------------------------------------------------
# Diese Lookups fügen Terrain-, Sicherheits- und Präferenz-Infos hinzu,
# verlangsamen aber die Routenberechnung spürbar. Einzeln deaktivierbar.

# Alle optionalen Lookups auf einmal deaktivieren
# OPTIONAL_ROUTE_LOOKUPS_ENABLED=false

# Warnung vor Bahnübergängen auf der Route
# RAILWAY_SAFETY_ENABLED=false

# Streckenpräferenz-Hinweise (Radwegnetz, Hauptstraßenvermeidung)
# PREFERENCE_GUIDANCE_ENABLED=false

# Bevorzugung von Radwegen beim Routing
# CYCLEWAY_AFFINITY_ENABLED=false

# Windgeschwindigkeits- und Wetterwarnungen via Open-Meteo
# WIND_SPEED_ENABLED=true

# Open-Meteo Wind/Wetter-API-Endpunkt
# WIND_API=https://api.open-meteo.com/v1/forecast

# Debug-Logging für optionale Lookups
# DEBUG_OPTIONAL_LOOKUPS=false


# ------------------------------------------------------------
# Elevation
# ------------------------------------------------------------

# Reihenfolge der Elevation-Provider (kommagetrennt)
# ELEVATION_PROVIDER_ORDER=open-meteo,open-elevation

# Maximale Profilpunkte pro Anfrage
# ELEVATION_MAX_POINTS=120

# Batch-Größe für parallele Elevation-Anfragen (allgemein)
# ELEVATION_BATCH_SIZE=60

# Batch-Größe speziell für Open-Meteo
# ELEVATION_OPEN_METEO_BATCH_SIZE=50

# Maximale Wiederholungsversuche bei Elevation-Fehlern
# ELEVATION_MAX_RETRIES=3

# Wartezeit zwischen Wiederholungen in ms
# ELEVATION_RETRY_DELAY_MS=400

# Timeout pro Elevation-Request in ms
# ELEVATION_TIMEOUT_MS=15000

# Cache-TTL für Elevation-Daten in ms (Standard: 30 Tage)
# ELEVATION_CACHE_TTL_MS=2592000000


# ------------------------------------------------------------
# Geocoding & POI-Suche
# ------------------------------------------------------------

# POI-Suchanbieter: overpass (Standard) oder geoapify
# POI_PROVIDER=overpass

# Nominatim-Endpunkt für Adresssuche
# NOMINATIM_API=https://nominatim.openstreetmap.org/search

# Overpass-API-Endpunkt für POI- und Terrain-Abfragen
# OVERPASS_API=https://overpass-api.de/api/interpreter

# Kommagetrennte Overpass-Endpunkte (wird rotiert bei Fehlern)
# OVERPASS_API_LIST=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://lz4.overpass-api.de/api/interpreter

# Suchradius für POI-Suche in Metern
# GEOCODING_POI_RADIUS_M=45000

# Timeout für Geocoding-Requests in ms
# GEOCODING_TIMEOUT_MS=10000

# Cache-TTL für Geocoding-Ergebnisse in ms (Standard: 30 Tage)
# GEOCODING_CACHE_TTL_MS=2592000000

# Cache-TTL für Overpass-Abfragen in ms (Standard: 7 Tage)
# OVERPASS_CACHE_TTL_MS=604800000

# Geoapify API-Key (nur wenn POI_PROVIDER=geoapify)
# GEOAPIFY_API_KEY=your_geoapify_key

# Geoapify Places-API-Endpunkt (nur wenn POI_PROVIDER=geoapify)
# GEOAPIFY_PLACES_API=https://api.geoapify.com/v2/places


# ------------------------------------------------------------
# Kartenkacheln (Tile Proxy)
# ------------------------------------------------------------
# Der Backend-Tile-Proxy cacht Thunderforest-Kacheln serverseitig –
# der API-Key gelangt nie in den Browser.
# Kacheln werden über /api/tiles/:style/:z/:x/:y.png ausgeliefert.
# Ohne Key fällt das Frontend auf OpenStreetMap-Kacheln zurück.

# Thunderforest API-Key – https://www.thunderforest.com
# THUNDERFOREST_API_KEY=your-key-here

# Cache-TTL für Kartenkacheln in ms (Standard: 90 Tage)
# TILE_CACHE_TTL_MS=7776000000


# ------------------------------------------------------------
# Dateiablage (Backend)
# ------------------------------------------------------------

# Gespeicherte Routen der Nutzer (JSON-Dateien)
# ROUTESHRED_ROUTES_DIR=./data/routes

# Gruppenfahrten (JSON-Dateien)
# ROUTESHRED_GROUP_RIDES_DIR=./data/group-rides

# Nutzerprofile / Fahrerprofile (JSON-Dateien)
# ROUTESHRED_PROFILE_DIR=./data/profiles

# Allgemeiner Disk-Cache (Elevation, Overpass, Tiles)
# ROUTESHRED_CACHE_DIR=./data/cache


# ------------------------------------------------------------
# Keycloak – Authentifizierung (optional)
# ------------------------------------------------------------
# Ohne Keycloak läuft RouteShred im anonymen Modus:
# Routenplanung und Export funktionieren, Meine Routen und
# Community-Features sind nicht verfügbar.

# Keycloak aktivieren
KEYCLOAK_ENABLED=true

# Interne Keycloak-URL (Backend → Keycloak, z.B. Docker-intern)
KEYCLOAK_URL=http://keycloak:8080

KEYCLOAK_REALM=routeshred
KEYCLOAK_CLIENT_ID=routeshred-frontend

# Admin-Zugangsdaten (werden für User-Suche beim Teilen von Routen benötigt)
KEYCLOAK_ADMIN=routeshred-admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Keycloak-Datenbank (PostgreSQL)
KC_DB_USER=kc_routeshred
KC_DB_PASSWORD=change-me


# ------------------------------------------------------------
# Frontend (React – werden zur Build-Zeit eingebaut)
# ------------------------------------------------------------

# Backend-API-Basispfad (im Dev-Modus über CRA-Proxy, in Prod über Caddy)
# REACT_APP_API_URL=/api

# Keycloak-URL wie sie der Browser sieht (öffentliche URL!)
REACT_APP_KEYCLOAK_ENABLED=true
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_KEYCLOAK_REALM=routeshred
REACT_APP_KEYCLOAK_CLIENT_ID=routeshred-frontend

# Kartenkachel-URL (Standard: interner Tile-Proxy)
# REACT_APP_TILE_URL=/api/tiles/cycle/{z}/{x}/{y}.png
# REACT_APP_TILE_ATTRIBUTION=&copy; OpenCycleMap

# Sprache der UI: de (Standard) oder en
# REACT_APP_LANGUAGE=de
