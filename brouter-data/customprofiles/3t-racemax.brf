# 3t-racemax.brf
# Custom BRouter profile for a 3T Racemax gravel / road-crossover bike.
# Rider: 87 kg, FTP 250 W
#
# Key characteristics:
#   - 3T Racemax: fundamentally road-oriented, accepts light gravel + smooth tracks
#   - Fine gravel, compacted, grade-1 tracks treated as preferred terrain
#   - Rough dirt, technical trails heavily penalized (this is not an MTB)
#   - Prefers quiet roads, cycling infrastructure and off-road paths
#   - Avoids Bundesstrassen/primary roads where quieter alternatives exist
#   - Semi-aero position: wider (38-40mm) tires, C_r slightly higher than road
#   - Climbs weighted normally -- gravel riders seek challenging terrain

---context:global

assign validForBikes true
assign turnInstructionMode          1
assign turnInstructionRoundabouts   true
assign considerTurnRestrictions     true
assign correctMisplacedViaPoints    true
assign correctMisplacedViaPointsDistance 1200
assign pass1coefficient 4

assign allow_steps    false
assign allow_ferries  true
assign allow_motorways false

assign consider_traffic      true
assign consider_elevation    true
assign prefer_unpaved_paths  false   # not a trail grinder
assign assume_wet_conditions false

# Kinematic model
# 87 kg rider + 10 kg Racemax = 97 kg total
assign totalMass  = 97
# Average output ~72% FTP (180 W) on mixed terrain
assign bikerPower = 180
# Gravel / road crossover position
assign S_C_x      = 0.250
# 38mm gravel/road tires: Crr ~= 0.006
assign C_r        = 0.006
assign maxSpeed   = 50

# Elevation -- gravel riders welcome rolling and hilly terrain
assign downhillcost   20
assign downhillcutoff 1.5
assign uphillcost     0
assign uphillcutoff   1.5

assign use_proposed_cycleroutes false

---context:way

# -- Surface classification --------------------------------------------------

assign ispaved
  or surface=asphalt or surface=concrete or surface=paved
  or surface=paving_stones or surface=sett
  or smoothness=excellent smoothness=good

assign isfinegravel
  or surface=fine_gravel or surface=compacted surface=gravel

assign isrogh
  or surface=ground or surface=dirt or surface=mud
  or surface=grass  or surface=sand surface=earth

assign has_decent_surface
  or ispaved isfinegravel

# -- Bad on steep slopes (technical rough tracks) ---------------------------

assign bad_when_steep
  and highway=track|path
    not or tracktype=grade1|grade2 has_decent_surface

# -- Surface quality penalty ------------------------------------------------

assign smoothnesspenalty
  switch smoothness=excellent    1.0
  switch smoothness=good         1.1
  switch smoothness=intermediate 1.3
  switch smoothness=bad          2.0
  switch smoothness=very_bad     5.0
  switch smoothness=horrible     10.0
  switch smoothness=impassable   100.0
  # Estimate from surface tag
  switch surface=asphalt         1.0
  switch surface=concrete        1.0
  switch surface=paving_stones   1.1
  switch surface=fine_gravel     1.1
  switch surface=compacted       1.1
  switch surface=gravel          1.2   # fine gravel road -- Racemax loves this
  switch surface=pebblestone     1.5
  switch surface=cobblestone|sett 1.8
  switch surface=ground|dirt     2.5
  switch surface=grass           3.5
  switch surface=mud|sand        8.0
  # Estimate from tracktype for unmarked tracks
  switch highway=track
    switch tracktype=grade1      1.1
    switch tracktype=grade2      1.3
    switch tracktype=grade3      2.0
    switch tracktype=grade4      4.0
    switch tracktype=grade5      7.0
    switch has_decent_surface    1.2
                                 2.5
  # Fallback for main roads
  switch highway=primary|primary_link|secondary|secondary_link|tertiary|tertiary_link 1.0
  switch highway=service|unclassified|living_street|residential 1.0
  switch highway=cycleway        1.0
  1.5

# -- Cycle route bonus -------------------------------------------------------

assign any_cycleroute
  or route_bicycle_icn=yes or route_bicycle_ncn=yes
  or route_bicycle_rcn=yes route_bicycle_lcn=yes

assign notcycleroutepenalty switch any_cycleroute 1.0 1.05

# -- Access / bike access logic ---------------------------------------------

assign defaultaccess
  switch access=
    switch or highway=motorway or highway=motorway_link motorroad=yes
      false
      true
    switch or access=private access=no
      false
      true

assign bikeaccess
  switch bicycle=
    switch bicycle_road=yes true
      switch vehicle=
        switch highway=footway false defaultaccess
        not vehicle=private|no
    not or bicycle=private or bicycle=no or bicycle=dismount bicycle=use_sidepath

assign footaccess
  or bicycle=dismount
    switch foot= defaultaccess
      not or foot=private or foot=no foot=use_sidepath

assign accesspenalty
  switch bikeaccess 0
    switch footaccess 5
      switch highway=footway|pedestrian 6 10000

# -- One-way ----------------------------------------------------------------

assign badoneway
  switch reversedirection=yes
    switch oneway:bicycle=yes true
      switch oneway= junction=roundabout
                     oneway=yes|true|1
    oneway=-1

assign hascycleway
  not and or cycleway= cycleway=no|none
          or cycleway:left=no|  cycleway:right=no|

assign onewaypenalty
  switch badoneway
    switch or hascycleway oneway:bicycle=no 0
      switch not footaccess 100
        switch junction=roundabout|circular 60
          switch highway=primary|primary_link 50
            switch highway=secondary|secondary_link 30 6
    0

# -- Traffic estimation -----------------------------------------------------

assign trafficpenalty
  switch consider_traffic
    switch hascycleway 0
      switch estimated_traffic_class=|1|2 0
        switch estimated_traffic_class=3 0.3
          switch estimated_traffic_class=4 0.8
            switch estimated_traffic_class=5 1.5
              switch estimated_traffic_class=6|7 2.5 0
    0

# -- Core cost factor -------------------------------------------------------

assign turncost switch junction=roundabout 15 65

assign initialcost
  switch route=ferry   20000
  switch highway=trunk|trunk_link 900
  switch highway=primary|primary_link 700
  switch highway=secondary|secondary_link 180
  switch highway=tertiary|tertiary_link 40 20

assign costfactor
  switch and highway= not route=ferry 10000
  switch or highway=proposed highway=abandoned 10000
  min 9999
  add max onewaypenalty accesspenalty
  add trafficpenalty

  multiply notcycleroutepenalty
  multiply smoothnesspenalty

  switch or highway=motorway highway=motorway_link
    switch allow_motorways 1.5 10000
  switch or highway=trunk highway=trunk_link 12.0
  switch or highway=primary highway=primary_link 4.2
  switch or highway=secondary highway=secondary_link 1.45
  switch or highway=tertiary highway=tertiary_link 0.95
  switch    highway=unclassified   0.85
  switch    highway=residential    0.83
  switch    highway=living_street  0.85
  switch    highway=service        0.95
  switch    highway=cycleway       0.70
  switch    highway=pedestrian     switch hascycleway 1.3 4.0
  switch    highway=bridleway
              switch has_decent_surface 1.1 3.5
  switch    highway=steps          switch allow_steps 60 10000
  switch    route=ferry            switch allow_ferries 5 10000
  switch or highway=track or highway=path or highway=road highway=footway
    switch tracktype=grade1        1.0
    switch tracktype=grade2        1.2
    switch tracktype=grade3        switch has_decent_surface 2.0  5.0
    switch tracktype=grade4        switch has_decent_surface 4.0 10.0
    switch tracktype=grade5        15.0
    switch ispaved                 1.1
    switch isfinegravel            1.1
    switch isrogh                  6.0
                                   2.5
  1.5

# -- Voice hint priorities --------------------------------------------------

assign priorityclassifier
  if      highway=motorway     then 30
  else if highway=trunk        then 28
  else if highway=primary      then 26
  else if highway=secondary    then 24
  else if highway=tertiary     then 22
  else if highway=unclassified then 20
  else if highway=residential  then 18
  else if highway=living_street then 16
  else if highway=service      then 14
  else if highway=cycleway     then 12
  else if highway=path         then 10
  else if highway=track        then  8
  else if highway=footway      then  6
  else 0

---context:node

assign defaultpenalty 0

---context:relation

assign onewayweight 0.05

---context:global

assign turncostbase 90
